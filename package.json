{
  "name": "noctra-ops",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/ops-web",
    "build": "npm run build --workspace apps/ops-web",
    "start": "npm run start --workspace apps/ops-web",
    "lint": "npm run lint --workspace apps/ops-web",
    "ops:dev": "npm run dev --workspace apps/ops-web",
    "ops:build": "npm run build --workspace apps/ops-web",
    "ops:start": "npm run start --workspace apps/ops-web",
    "ops:lint": "npm run lint --workspace apps/ops-web"
  }
}
