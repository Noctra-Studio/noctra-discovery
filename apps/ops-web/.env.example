# --- Brand (white-label; defaults = Noctra Studio if unset) ---
NEXT_PUBLIC_BRAND_NAME=Noctra Studio
NEXT_PUBLIC_BRAND_SHORT=Noctra
NEXT_PUBLIC_BRAND_URL=https://noctra.studio
# Path under /public for admin + login logo (PNG/SVG).
NEXT_PUBLIC_ADMIN_LOGO_PATH=/noctra-logo-white.png

# --- Clone / white-label (required for each client deployment) ---
# Public URL of this Vercel project + custom domain (no trailing slash).
# Used for discovery form links, emails, and auth redirects.
NEXT_PUBLIC_APP_URL=https://ops.example.com

# Optional: used by marketing/sitemap helpers if you keep those routes.
NEXT_PUBLIC_SITE_URL=https://ops.example.com

# --- Supabase (client’s project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend; verify the client’s sending domain) ---
RESEND_API_KEY=
FROM_EMAIL=Discovery <noreply@ops.example.com>
TO_EMAIL=team@example.com

# Contact form (marketing) — optional if routes disabled
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# --- Admin gate (login) ---
ADMIN_EMAIL=

# --- Rate limit (submit API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
